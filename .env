# Backend API base URL. Leave empty to run on sample data (no backend needed).
VITE_API_URL=

# Optional: endpoint paths, used only when VITE_API_URL is set.
VITE_API_PROPERTIES_PATH=/properties
VITE_API_BOOKINGS_PATH=/bookings

# Live accounts (Supabase). Leave empty to use the local demo accounts.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=